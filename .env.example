# ==============================================================================
# CaptionStudio Enterprise SaaS — Environment Configuration
# ==============================================================================

# --- Security & JWT Authentication ---
# Generate with: openssl rand -hex 32
SECRET_KEY=change_this_to_a_super_secure_random_64_character_string_in_production
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ALGORITHM=HS256

# --- CORS Settings ---
# Comma-separated list of allowed origins
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8000,http://127.0.0.1:5173,http://127.0.0.1:8000

# --- Database Configuration ---
# Production PostgreSQL:
DATABASE_URL=postgresql://caption_user:caption_pass@localhost:5432/captionstudio
# Local SQLite fallback:
# DATABASE_URL=sqlite:///./storage/captionstudio.db

# --- Distributed Job Queue (Redis) ---
REDIS_URL=redis://localhost:6379/0

# --- Storage Layer ---
# Supported drivers: local | s3
STORAGE_DRIVER=local
STORAGE_DIR=storage
MAX_UPLOAD_SIZE_MB=500

# AWS S3 Configuration (when STORAGE_DRIVER=s3)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_S3_BUCKET_NAME=

# --- Seed SaaS Administrator ---
INITIAL_ADMIN_EMAIL=admin@captionstudio.com
INITIAL_ADMIN_PASSWORD=Admin12345!

# --- AI & Speech-to-Text Engine ---
WHISPER_MODEL=base
TRANSLATION_ENGINE=google

