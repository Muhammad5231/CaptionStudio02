# Large binaries (GitHub rejects files > 100MB)
ffmpeg.exe
*.exe

# Storage & User Media (keep directory structure with .gitkeep)
backend/storage/uploads/*
!backend/storage/uploads/.gitkeep
backend/storage/renders/*
!backend/storage/renders/.gitkeep
backend/storage/thumbnails/*
!backend/storage/thumbnails/.gitkeep
backend/storage/*.db
backend/storage/*.db-journal
backend/storage/*.wav
backend/storage/*.ass

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.coverage
htmlcov/
dist/
build/
*.egg-info/

# Virtual Environments
venv/
.venv/
env/
ENV/

# Node & Frontend
frontend/node_modules/
frontend/dist/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Environment variables & secrets
.env
.env.local
.env.*.local

# IDE & OS
.vscode/
.idea/
.DS_Store
Thumbs.db

